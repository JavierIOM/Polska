# Copy to .env and fill in. .env is gitignored and must never be committed.
# On the droplet these are set in the environment or docker-compose, not in a file.

# --- Anthropic -------------------------------------------------------------
# Read without the POLSKA_ prefix: the Claude Agent SDK expects this exact name.
ANTHROPIC_API_KEY=

# --- Dashboard auth --------------------------------------------------------
# Argon2 hash of the admin password, never the password itself.
# Generate both of these with: python -m polska.cli init-auth
POLSKA_ADMIN_PASSWORD_HASH=
POLSKA_SESSION_SECRET=
POLSKA_SESSION_MAX_AGE_SECONDS=43200

# --- Paths and storage -----------------------------------------------------
POLSKA_DATABASE_URL=sqlite+pysqlite:///data/polska.db
POLSKA_CONFIG_PATH=config/default.yaml
POLSKA_COMPANIES_DIR=companies
POLSKA_WORKSPACE_ROOT=data/workspaces

# --- Behaviour -------------------------------------------------------------
POLSKA_LOG_LEVEL=INFO
POLSKA_SQL_ECHO=false
POLSKA_DEV_MODE=false

# --- Integration credentials (phase 6, unused in phase 1) ------------------
# Named in a company profile under 'secret_env'. The dry-run adapter reads none
# of these; the real adapters read them at call time and never persist them.
GITHUB_TOKEN=
BUFFER_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
